{
  "name": "@mba-demo/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=development --test src/**/*.test.ts",
    "auth:generate": "auth generate --config ./src/index.ts --output ../db/src/schema/auth.ts --yes",
    "auth:create-admin": "auth create-admin --config ./src/index.ts"
  },
  "dependencies": {
    "@better-auth/sso": "1.7.6",
    "@mba-demo/db": "0.0.0",
    "@mba-demo/kv": "0.0.0",
    "better-auth": "^1.7.6"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "auth": "^1.7.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
