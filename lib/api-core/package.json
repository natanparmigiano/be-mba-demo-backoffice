{
  "name": "@mba-desk/api-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./src/app.ts",
      "development": "./src/app.ts",
      "default": "./dist/app.js"
    },
    "./application-urls": {
      "types": "./src/application-urls.ts",
      "development": "./src/application-urls.ts",
      "default": "./dist/application-urls.js"
    },
    "./routes/*": {
      "types": "./src/routes/*.ts",
      "development": "./src/routes/*.ts",
      "default": "./dist/routes/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--no-node-snapshot tsx --conditions=development --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "@hono/node-server": "^1.19.1",
    "@mba-desk/auth": "0.0.0",
    "@mba-desk/db": "0.0.0",
    "@mba-desk/events": "0.0.0",
    "@mba-desk/files": "0.0.0",
    "@mba-desk/kv": "0.0.0",
    "@mba-desk/pubsub": "0.0.0",
    "@mba-desk/wa-analytics": "0.0.0",
    "@mba-desk/wa-components": "0.0.0",
    "@mba-desk/wa-mba": "0.0.0",
    "@mba-desk/wa-qr": "0.0.0",
    "@mba-desk/wa-registration": "0.0.0",
    "@mba-desk/wa-subscriptions": "0.0.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.13.12",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
