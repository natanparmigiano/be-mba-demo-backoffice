# The local defaults work without this file. Copy it to .env to customize them.
# For the container-backed development stack, copy .env.dev instead.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mba_demo_backoffice
# Leave unset to use the process-local in-memory KV store.
# REDIS_URL=redis://localhost:6379
# Set both values to use Kafka; leave both unset for the in-memory event bus.
# KAFKA_CLIENT_ID=mba-demo-api
# KAFKA_BROKERS=localhost:9092
# KAFKA_GROUP_ID=mba-demo-api-consumer
SUBSCRIBE_TO_TOPICS=all
ENABLE_WORKER_IN_PROCESS=true
WA_WEBHOOK_MAX_RETRIES=5

# Filesystem storage is the dependency-free default. Use a private production secret.
FILES_ADAPTER=fs
FILES_DIRECTORY=.data/files
FILES_PUBLIC_URL=http://localhost:3000
FILES_SIGNING_SECRET=development-only-files-signing-secret
# PostgreSQL blob storage (`FILES_ADAPTER=postgres`) is only for quick tests and
# short-lived demos without a persistent filesystem. Do not use it in production.
# To use S3, set FILES_ADAPTER=s3 and configure FILES_S3_BUCKET. Custom
# S3-compatible services also use FILES_S3_ENDPOINT and typically path-style URLs.
# FILES_S3_BUCKET=mba-demo-files
# FILES_S3_CREATE_BUCKET=true
# FILES_S3_REGION=us-east-1
# FILES_S3_ENDPOINT=http://localhost:9000
# FILES_S3_PUBLIC_ENDPOINT=http://localhost:9000
# FILES_S3_FORCE_PATH_STYLE=true
# FILES_S3_ACCESS_KEY_ID=minioadmin
# FILES_S3_SECRET_ACCESS_KEY=minioadmin
BETTER_AUTH_SECRET=development-only-secret-change-before-production
BETTER_AUTH_URL=http://localhost:3000
# Required for OIDC: comma-separated exact origins used by discovery/token/JWKS endpoints.
# BETTER_AUTH_TRUSTED_ORIGINS=https://idp.example.com
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Comma-separated hostnames accepted by the remote MCP endpoint (no ports).
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Docker Compose overrides for the public Hono endpoint.
WEB_PORT=8080
COMPOSE_BETTER_AUTH_URL=http://localhost:8080
COMPOSE_CORS_ORIGIN=http://localhost:8080
COMPOSE_FILES_PUBLIC_URL=http://localhost:8080
