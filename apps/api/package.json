{
  "name": "@mba-demo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=development --test src/**/*.test.ts"
  },
  "dependencies": {
    "@mba-demo/auth": "0.0.0",
    "@mba-demo/db": "0.0.0",
    "@mba-demo/events": "0.0.0",
    "@mba-demo/kv": "0.0.0",
    "@mba-demo/schemas": "0.0.0",
    "@hono/node-server": "^1.19.1",
    "@hono/zod-validator": "^0.7.2",
    "hono": "^4.9.8",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
