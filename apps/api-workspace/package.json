{
  "name": "@mba-desk/api-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "development": "./src/app.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "WORKSPACE_API_PORT=3000 BETTER_AUTH_URL=http://localhost:44100 CORS_ORIGIN=http://localhost:44100 WORKSPACE_CORS_ORIGIN=http://localhost:44100 NODE_OPTIONS=--no-node-snapshot tsx watch --conditions=development --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --no-node-snapshot --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--no-node-snapshot tsx --conditions=development --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@mba-desk/api-core": "0.0.0",
    "@mba-desk/api-workspace-core": "0.0.0",
    "@mba-desk/events": "0.0.0",
    "@mba-desk/files": "0.0.0",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
