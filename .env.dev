# Local application processes connect to the infrastructure exposed by compose.dev.yaml.
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mba_demo_backoffice
REDIS_URL=redis://localhost:6379

KAFKA_CLIENT_ID=mba-demo-dev
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=mba-demo-dev-consumer
SUBSCRIBE_TO_TOPICS=all
ENABLE_WORKER_IN_PROCESS=true
WA_WEBHOOK_MAX_RETRIES=5

FILES_ADAPTER=s3
FILES_S3_BUCKET=mba-demo-files
FILES_S3_CREATE_BUCKET=true
FILES_S3_REGION=us-east-1
FILES_S3_ENDPOINT=http://localhost:9000
FILES_S3_PUBLIC_ENDPOINT=http://localhost:9000
FILES_S3_FORCE_PATH_STYLE=true
FILES_S3_ACCESS_KEY_ID=minioadmin
FILES_S3_SECRET_ACCESS_KEY=minioadmin

BETTER_AUTH_SECRET=development-only-secret-change-before-production
BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_TRUSTED_ORIGINS=https://idp.example.com
PORT=3000
CORS_ORIGIN=http://localhost:5173
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
